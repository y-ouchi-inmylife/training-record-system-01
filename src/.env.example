APP_NAME="トレーニング記録管理システム"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://mikan.inmylife1965.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=null
MAIL_HOST=inmylife1965.sakura.ne.jp
MAIL_PORT=587
MAIL_USERNAME=noreply@inmylife1965.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@inmylife1965.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# トレーナーポータルのシステム名（ブラウザタイトルの末尾サフィックス）
TRAINER_PORTAL_NAME="トレーニング記録管理システム"

# クライアントポータルのシステム名（ログイン画面のワードマーク）・会社名（フッターの提供会社名）
CLIENT_PORTAL_NAME="Mirai Dog Wellness"
CLIENT_PORTAL_COMPANY="Mirai Dog Wellness"

# サブドメイン構成（トレーナー / クライアント）
TRAINER_HOST=mikan-trs01-staff.inmylife1965.com
CLIENT_HOST=mikan.inmylife1965.com

# セッション役割別設定（トレーナー / クライアント）
TRAINER_SESSION_LIFETIME=120
CLIENT_SESSION_LIFETIME=120
TRAINER_SESSION_COOKIE=trs01-staff-session
CLIENT_SESSION_COOKIE=trs01-client-session
# サブドメインが別ホストのため SESSION_DOMAIN は設定しない
# （設定すると Cookie に先頭ドットが付き認証不整合を起こす。別ホストなので未設定でホスト限定になる）
# TRAINER_SESSION_DOMAIN=mikan-trs01-staff.inmylife1965.com
# CLIENT_SESSION_DOMAIN=mikan.inmylife1965.com

# プライバシーポリシー
#CLIENT_PORTAL_PRIVACY_URL=

# 外部API
# 音声文字起こし
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_REQUEST_TIMEOUT=300
# 要約
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Media conversion (ImageMagick)
MAGICK_PATH=/usr/bin/convert

# Media conversion (FFmpeg)
FFMPEG_PATH=/usr/bin/ffmpeg

# Media File Storage (S3 compatible)
MEDIA_STORAGE_ENDPOINT=https://s3.tky01.sakurastorage.jp
MEDIA_STORAGE_BUCKET=trs01-media-prod
MEDIA_STORAGE_REGION=jp-east-1
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=

# Backup
BACKUP_DIRECTORY=/var/www/training-record-system-01/src/storage/app/backups
BACKUP_ENCRYPTION_KEY=
MYSQLDUMP_PATH=/usr/bin/mysqldump
MYSQL_PATH=/usr/bin/mysql
OPENSSL_PATH=/usr/bin/openssl

# Backup File Storage (S3 compatible)
BACKUP_STORAGE_ENDPOINT=https://7e2d676e31f746acd5bcc20fd6333e6c.r2.cloudflarestorage.com
BACKUP_STORAGE_BUCKET=trs01-backup-prod
#BACKUP_STORAGE_REGION=
BACKUP_STORAGE_ACCESS_KEY_ID=
BACKUP_STORAGE_SECRET_ACCESS_KEY=
